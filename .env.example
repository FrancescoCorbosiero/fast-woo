# ============================================
# fast-woo - variabili d'ambiente
# ============================================
# Copiare in .env e compilare la sezione OBBLIGATORIE.
# Le variabili commentate mostrano il default usato da docker-compose.yml:
# decommentarle solo per cambiarle. Un .env di una versione precedente
# continua a funzionare senza modifiche.
# Dopo ogni modifica: docker compose up -d  (ricrea solo i container interessati)

# --------------------------------------------
# OBBLIGATORIE
# --------------------------------------------
PROJECT_NAME=miosito
DOMAIN=example.com
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=cambiami
DB_ROOT_PASSWORD=cambiami-anche-questa

# TABLE_PREFIX=wp_

# --------------------------------------------
# WORDPRESS / PHP  (asse "traffico")
# --------------------------------------------
# Memoria del container WordPress
# WP_MEMORY_LIMIT_CONTAINER=1G
# WP_MEMORY_RESERVATION=512M
# Core massimi per WordPress (0 = nessun limite)
# WP_CPU_LIMIT=0

# Processi PHP contemporanei (Apache prefork). Calcolo nel README:
#   min( 2-3 x vCPU ,  (WP_MEMORY_LIMIT_CONTAINER - PHP_OPCACHE_MEMORY - 100MB) / RAM per processo )
# APACHE_MAX_WORKERS=10
# Ricicla ogni processo dopo N connessioni (limita i memory leak dei plugin)
# APACHE_MAX_CONN_PER_CHILD=1000

# Memoria massima per singola richiesta PHP
# PHP_MEMORY_LIMIT=512M
# PHP_MAX_EXECUTION_TIME=600
# PHP_MAX_INPUT_VARS=5000
# OPcache in MB (condivisa tra tutti i processi)
# PHP_OPCACHE_MEMORY=256

# Costanti WordPress. NOTA: WP_MEMORY_LIMIT / WP_MAX_MEMORY_LIMIT possono solo
# ALZARE PHP_MEMORY_LIMIT, mai abbassarlo. Configurazione consigliata:
# PHP_MEMORY_LIMIT=256M (frontend) e WP_MAX_MEMORY_LIMIT=512M (admin, import).
# WP_MEMORY_LIMIT=256M
# WP_MAX_MEMORY_LIMIT=384M

# Valori booleani: solo true/false
# DISALLOW_FILE_EDIT=false
# true SOLO dopo aver aggiunto il cron sulla VPS (vedi README, sezione Cron)
# DISABLE_WP_CRON=false

# Hardening opzionale
# Nega l'esecuzione di PHP in wp-content/uploads
# APACHE_BLOCK_UPLOADS_PHP=false
# Nega xmlrpc.php (lasciare false se usi Jetpack o app che lo richiedono)
# APACHE_BLOCK_XMLRPC=false

# --------------------------------------------
# MARIADB  (asse "dimensione catalogo")
# --------------------------------------------
# MARIADB_MEMORY_LIMIT=512M
# MARIADB_MEMORY_RESERVATION=256M
# Core massimi per MariaDB (0 = nessun limite)
# MARIADB_CPU_LIMIT=0
# ~50-60% di MARIADB_MEMORY_LIMIT sotto i 2G, ~70-75% sopra
# MARIADB_BUFFER_POOL=384M
# Redo log: ~25% del buffer pool per store con molte scritture (es. 256M-1G)
# MARIADB_LOG_FILE_SIZE=64M
# 1 = nessuna transazione persa se il server va giù (consigliato per gli ordini)
# 2 = più veloce, si può perdere ~1s di transazioni in caso di crash dell'host
# MARIADB_FLUSH_LOG_AT_TRX_COMMIT=2
# Dischi SSD/NVMe: 1000-2000
# MARIADB_IO_CAPACITY=200
# MARIADB_MAX_CONNECTIONS=151
# MARIADB_TMP_TABLE_SIZE=16M
# MARIADB_ARIA_PAGECACHE=32M
# MARIADB_KEY_BUFFER=16M
# MARIADB_SLOW_QUERY_TIME=2

# --------------------------------------------
# REDIS
# --------------------------------------------
# REDIS_MAXMEMORY=128mb
# Tenere ~1.5x REDIS_MAXMEMORY
# REDIS_MEMORY_LIMIT=160M

# --------------------------------------------
# BACKUP DATABASE
# --------------------------------------------
# Cron a 5 campi, nel fuso BACKUP_TIMEZONE. Deve girare PRIMA del backup della VPS.
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_TIMEZONE=Etc/GMT
# 14 giorni = 60*24*14
# BACKUP_RETENTION_MINUTES=20160

# --------------------------------------------
# PHPMYADMIN (solo con --profile debug)
# --------------------------------------------
# PHPMYADMIN_PORT=8081
